@model List<SectionDto>
@{
    ViewData["Title"] = Localizer["sections"];
    ViewData["UnitTestPageClass"] = "ut-sections-index";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}

<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3> @Localizer["sections"] <small></small></h3>
        </div>
        <div class="title_right">
            <a href="@Url.AdminUrl("Create" , "sections")"
               class="btn btn-blue btn-add-new ut-create-btn">@Localizer["new_section"]</a>
        </div>
    </div>
</div>

  
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">

        @{
            
                ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { };
             
        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")


        <div class="x_panel p-x-0">

            <div class="x_content">
                <div class="table-responsive">
                    <table class="table table-middle table-striped sections-table" id="sectionsTable">
                        <thead>
                        <th width="100" class="text-center">@Localizer["t_image"]</th>
                        <th>@Localizer["t_title"]</th>

                        <th>@Localizer["t_summary"]</th>

                        <th width="150">@Localizer["t_section_parent"]</th>

                        <th width="100" class="text-center">@Localizer["t_visibility"]</th>
                        <th width="175">@Localizer["t_actions"]</th>
                        </thead>
                        <tbody>
                            @if (Model.Count > 0)
                            {
                                @foreach (var item in Model)
                                {

                                    <tr id="tr-@item.Id">
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.MainImage))
                                            {

                                                <img src="@item.MainImage" alt="" width="60" />
                                            }
                                            else
                                            {
                                                <img src="~/Admin/img/noimage.jpg" alt="" width="75" />
                                            }
                                        </td>
                                        <td style="min-width:150px">
                                            @item.Title
                                        </td>


                                        <td>
                                            <div class="s-summary">
                                                @{
                                                    string text = "";
                                                    if (!string.IsNullOrWhiteSpace(item.Summary))
                                                    {
                                                        text = Regex.Replace(item.Summary, "<.*?>", String.Empty);
                                                    }
                                                }
                                                @Html.Raw(text)
                                            </div>
                                        </td>
                                        <td>
                                            @item.ParentName
                                        </td>
                                        <td>

                                            @if (item.Locked)
                                            {
                                                @if (item.Published)
                                                {
                                                    <span data-toggle="tooltip"
                                                          data-placement="top"
                                                          title="@Localizer["locked_by_system"]">
                                                        <i class="fa fa-eye c-green"></i>
                                                        <small>@Localizer["t_published"]</small>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span data-toggle="tooltip"
                                                          data-placement="top"
                                                          title="@Localizer["locked_by_system"]">
                                                        <i class="fa fa-eye-slash c-red"></i>
                                                        <small>@Localizer["t_unpublished"]</small>
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                @if (item.Published)
                                                {
                                                    <a data-toggle="tooltip"
                                                       data-placement="top"
                                                       data-status="true"
                                                       data-url="@Url.AdminUrl("PublishAsync","sections" , new { id = item.Id})"
                                                       title="@Localizer["t_unpublish"]"
                                                       data-unpublished="@Localizer["t_unpublished"]"
                                                       data-published="@Localizer["t_published"]"
                                                       class="btn btn-link-pup published ut-published toggle_publish">
                                                        <i class="fa fa-eye c-green"></i>
                                                        <small>@Localizer["t_published"]</small>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a data-toggle="tooltip"
                                                       data-placement="top"
                                                       data-url="@Url.AdminUrl("PublishAsync","sections" , new { id = item.Id})"
                                                       title="@Localizer["t_publish"]"
                                                       data-unpublished="@Localizer["t_unpublished"]"
                                                       data-published="@Localizer["t_published"]"
                                                       class="btn btn-link-pup unpublished ut-unpublished toggle_publish">
                                                        <i class="fa fa-eye-slash c-red"></i>
                                                        <small>@Localizer["t_unpublished"]</small>
                                                    </a>
                                                }
                                            }
                                        </td>
                                        <td>
                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               title="@Localizer["t_details"]"
                                               href="@Url.AdminUrl("Details","sections",new { id = item.Id })"
                                               class="btn btn-view btn-round ut-detail_btn"><i class="fa fa-eye "></i></a>

                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               title="@Localizer["t_edit"]"
                                               href="@Url.AdminUrl("Edit" ,"sections",new { id = item.Id })"
                                               class="btn btn-edit btn-round ut-edit_btn"><i class="fa fa-edit "></i></a>

                                            @if (item.Locked)
                                            {
                                                <span data-toggle="tooltip"
                                                      data-placement="top"
                                                      class="btn-locked btn-round"
                                                      title="@Localizer["locked_by_system"]"><i class="fa fa-lock"></i></span>
                                            }
                                            else
                                            {
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-id="@item.Id"
                                                   data-url="@Url.AdminUrl("DeleteAsync", "sections", new { id = item.Id })"
                                                   title="@Localizer["t_remove"]"
                                                   class="btn btn-remove btn-round delete-service ut-section-removebtn"><i class="fa fa-times "></i></a>
                                            }


                                        </td>
                                    </tr>

                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class='empty_table text-center'> <i class='fa fa fa-exclamation-circle'></i><p>@Localizer["no_data_table"]</p></div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/Admin/js/sections.min.js"></script>

}