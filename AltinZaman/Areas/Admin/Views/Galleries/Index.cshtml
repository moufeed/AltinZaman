@model List<GalleryLiteDto>
@{
    ViewData["Title"] = Localizer["Galleries"];
    ViewData["UnitTestPageClass"] = "ut-Galleries-index";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);

    
}

<div class="clearfix"> 
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["Galleries"] <small></small></h3>
        </div>
        <div class="title_right">
            <a href="@Url.AdminUrl("Create" ,"Galleries")"
               class="btn btn-blue btn-add-new ut-NewGallery">@Localizer["new_gallery"]</a>
        </div>
    </div>
</div>



<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">

        @if (ViewBag.Languages?.Count > 1)
        {
            <header class="language_bar clearfix">
                <ul class="nav nav-tabs nav-header" role="tablist">
                    @foreach (var lang in ViewBag.Languages)
                    {
                        <li class="@((activeLang == lang.Lang) ? "active" :"" )">
                            <a href="@Url.AdminUrl("index", "galleries", new { culture = lang.Lang})">@lang.Name</a>
                        </li>
                    }
                </ul>
            </header>
        }

        <div class="x_panel p-x-0">
            <div class="x_content">
                <div class="table-responsive">
                    <table class="table table-middle table-striped services-table" id="ServicesTable">
                        <thead>
                        <th width="100" class="text-center">@Localizer["t_image"]</th>
                        <th width="150">title</th>
                        <th>@Localizer["t_slug"]</th>
                        <th>@Localizer["t_summary"]</th>
                        <th width="125">@Localizer["t_total_items"]</th>
                        <th width="100" class="text-center">@Localizer["t_display_order"]</th>
                        <th width="100" class="text-center">@Localizer["t_visibility"]</th>
                        <th width="250">@Localizer["t_actions"]</th>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                                <tr id="tr-@item.Id">
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.MainImage))
                                        {

                                            <img src="@item.MainImage" alt="" width="60" />
                                        }
                                        else
                                        {
                                            <img src="~/Admin/img/noimage.jpg" alt="" width="75" />
                                        }
                                    </td>
                                    <td>
                                        @item.Title
                                    </td>

                                    <td>@item.Slug</td>
                                    <td>
                                        <div class="s-summary">
                                            @{
                                                string text = String.Empty;
                                                if (item.Summary != null)
                                                {
                                                    text = Regex.Replace(item.Summary, "<.*?>", String.Empty);
                                                }

                                            }
                                            @Html.Raw(text)
                                        </div>
                                    </td>
                                    <td class="text-center">@item.ItemsCount</td>
                                    <td class="text-center">@item.DisplayOrder</td>
                                    <td>

                                        @if (item.Locked)
                                        {

                                            @if (item.Published)
                                            {
                                                <span data-toggle="tooltip"
                                                      data-placement="top"
                                                      title="@Localizer["locked_by_system"]">
                                                    <i class="fa fa-eye c-green"></i>
                                                    <small>@Localizer["t_published"]</small>
                                                </span>
                                            }
                                            else
                                            {
                                                <span data-toggle="tooltip"
                                                      data-placement="top"
                                                      title="@Localizer["locked_by_system"]">
                                                    <i class="fa fa-eye-slash c-red"></i>

                                                    <small>@Localizer["t_unpublished"]</small>
                                                </span>
                                            }
                                        }
                                        else
                                        {

                                            if (item.Published)
                                            {
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-status="true"
                                                   data-url="@Url.AdminUrl("PublishAsync" ,"galleries" , new { id= item.Id })"
                                                   title="@Localizer["t_unpublish"]"
                                                   data-type="gallery"
                                                   data-txt-published="@Localizer["t_published"]"
                                                   data-txt-unpublished="@Localizer["t_unpublished"]"
                                                   data-msg-error="@Localizer["error"]"
                                                   class="btn btn-link-pup btn-lg published toggle__publish ut-published">
                                                    <i class="fa fa-eye c-green"></i>
                                                    <small>@Localizer["t_published"]</small>
                                                </a>
                                            }
                                            else
                                            {
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-url="@Url.AdminUrl("PublishAsync" ,"galleries" , new { id= item.Id })"
                                                   title="@Localizer["t_publish"]"
                                                   data-type="gallery"
                                                   data-txt-published="@Localizer["t_published"]"
                                                   data-txt-unpublished="@Localizer["t_unpublished"]"
                                                   class="btn btn-link-pup btn-lg unpublished toggle__publish ut-unpublished">
                                                    <i class="fa fa-eye-slash c-red"></i>
                                                    <small>@Localizer["t_unpublished"]</small>
                                                </a>
                                            }

                                        }
                                    </td>

                                    <td>
                                        <a data-toggle="tooltip"
                                           data-placement="top"
                                           title="@Localizer["t_details"]"
                                           href="@Url.AdminUrl("Details","galleries" ,new { id = item.Id })"
                                           class="btn btn-view btn-round"><i class="fa fa-eye "></i></a>

                                        <a data-toggle="tooltip"
                                           data-placement="top"
                                           title="@Localizer["t_edit"]"
                                           href="@Url.AdminUrl("Edit" ,"galleries" ,new { id= item.Id})"
                                           class="btn btn-edit btn-round ut-edit-btn"><i class="fa fa-edit "></i></a>

                                        @if (item.Locked)
                                        {
                                            <span data-toggle="tooltip"
                                                  data-placement="top"
                                                  class="btn-locked btn-round"
                                                  title="@Localizer["locked_by_system"]"><i class="fa fa-lock"></i></span>
                                        }
                                        else
                                        {
                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               data-url="@Url.AdminUrl("DeleteAsync" ,"galleries" , new { id = item.Id })"
                                               title="@Localizer["t_remove"]"
                                               data-target="#tr-@item.Id"
                                               data-ut="tr-@item.Id"
                                               data-msg-error="@Localizer["error"]"
                                               data-msg-deleted="@Localizer["deleted_successfully"]"
                                               class="btn btn-remove btn-round delete__gallery ut-delete-btn"><i class="fa fa-times "></i></a>
                                        }
                                    </td>
                                </tr>

                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script src="~/Admin/js/galleries.min.js"></script>
}