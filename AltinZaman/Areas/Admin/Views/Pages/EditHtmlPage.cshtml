@model HtmlPageEditingVM
@using TamTechSDK.Common.Services.ContentService.Pages.Enums
@{
    ViewData["Title"] = Localizer["edit_htmal_page"];
    ViewData["UnitTestPageClass"] = "ut-editPage";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}



<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["html_editing_form"]</h3>
        </div>
        <div class="title_right">
            <a asp-action="Index"
               class="btn btn-blue"><span class="fa fa-chevron-left"></span>@Localizer["back_to_list"]</a>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        @if (ViewBag.Languages?.Count > 1)
        {
            <header class="language_bar clearfix">
                <ul class="nav nav-tabs nav-header" role="tablist">
                    @foreach (var lang in ViewBag.Languages)
                    {
                        <li class="@((activeLang == lang.Lang) ? "active" :"" )">
                            <a href="@Url.AdminUrl("EditHtmlPage", "Pages", new { culture = lang.Lang ,id = Model.Id})">@lang.Name</a>
                        </li>
                    }
                </ul>
            </header>
        }

        <div class="x_panel">
            <div class="x_content">

               


                <form asp-action="EditHtmlPage" asp-controller="Pages"
                      method="post"
                      id="EditPageForm"
                      enctype="multipart/form-data"
                      class="form-horizontal forn-new form-label-left m-t5">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    }
                     
                    <input type="hidden" asp-for="Id" class="ut-id" />
                    <input type="hidden" name="DatePublished" value="@(String.Format("{0:yyyy-MM-dd}", Model.PublishedDate))" data-seo-published />
                    <input type="hidden" name="DateModified" value="@(String.Format("{0:yyyy-MM-dd}", Model.ModifiedDate))" data-seo-modified />
                    <input type="hidden" name="Lang" value="@activeLang" />
                    <div class="form-group clearfix">
                        <label asp-for="Title" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_title"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <input type="text" asp-for="Title" class="form-control" required data-seo-name />
                            <span asp-validation-for="Title" class="text-danger invalid_field"></span>
                        </div>
                    </div>
                    <div class="form-group clearfix">
                        <label asp-for="Slug" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_slug"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">

                            @if (Model.Locked)
                            {
                                 <div class="input-group input-locked">
                                     
                                    <p class="form-control-static">@Model.Slug</p>
                                    <span class="input-group-addon"
                                          data-toggle="tooltip"
                                          data-placement="top"
                                          title="@Localizer["locked_by_system"]"><i class="fa fa-lock"></i></span>
                                </div>
                                
                            }
                            else
                            {
                                <input type="text" asp-for="Slug" class="form-control" required />
                            }
                            <span asp-validation-for="Slug" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">

                        <label asp-for="Section" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_section"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <input type="text" asp-for="Section" class="form-control" required />
                            <span asp-validation-for="Section" class="text-danger invalid_field"></span>
                        </div>
                    </div>




                    <div class="form-group clearfix">

                        <label asp-for="MainImage" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_main_image"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            @if (Model.MainImage != null)
                            {
                                <img src="@Model.MainImage" style="max-width:300px" data-seo-image="@Model.MainImage" class="img-thumbnail m-b3">
                                <input type="hidden" asp-for="MainImage" />
                            }

                            <label class="form-control clearfix uploadfile">
                                <input type="file" Name="NewMainImage" class="upload-input" data-text="Choose file." accept="image/*" />
                                <span class="url">Choose file.</span>
                                <span class="file-btn"><i class="fa fa-search"></i> Browse</span>
                            </label>
                            @Html.ValidationMessageFor(m => m.MainImage, "", new { @class = "text-danger invalid_field" })
                        </div>

                    </div>
                    <div class="form-group clearfix">
                        <label asp-for="AuthorName" class="control-label col-md-3 col-sm-3 col-xs-12">@Localizer["author_name"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <input type="text" asp-for="AuthorName" class="form-control" data-seo-author />
                            <span asp-validation-for="AuthorName" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">

                        <label asp-for="Summary" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_summary"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <textarea asp-for="Summary" class="form-control" rows="3" data-seo-description></textarea>
                            @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger " })
                        </div>
                    </div>

                    @*<div class="form-group clearfix">
                        @Html.Label("Published", "Page Visibility :", new { @class = "control-label col-md-3 col-sm-3 col-xs-12 " })
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            @Html.CheckBoxFor(m => m.Published, new { @class = "toggle_switch" })
                            @Html.ValidationMessageFor(m => m.Published, "", new { @class = "text-danger " })
                        </div>
                    </div>*@

                    <div class="form-group clearfix">
                        <label asp-for="Content" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_content"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Content" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <h4>
                        @Localizer["SEO"]
                    </h4>
                    <hr />


                    <div class="form-group clearfix">
                        @{
                            string keywords = string.Empty;

                            if (Model.KeywordsList.Count > 0)
                            {

                                List<string> list = Model.KeywordsList;
                                keywords = string.Join(",", list);
                            }
                        }

                        <label asp-for="Keywords" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_meta_keywords"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <div class="static-form-control">
                                <input type="text" name="Keywords" class="form-control" id="keywords" value="@keywords" />
                            </div>
                            <span asp-validation-for="Content" class="text-danger invalid_field"></span>
                        </div>

                    </div>


                    <div class="form-group clearfix">

                        <label asp-for="MetaDescription" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_meta_description"]</label>

                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <textarea asp-for="MetaDescription" class="form-control MetaDescription" data-characters='{"warning_count" : 158  , "maximum_count"  : 300 }' rows="3"></textarea>

                            @Html.ValidationMessageFor(m => m.MetaDescription, "", new { @class = "text-danger " })

                        </div>
                    </div>


                    @await Html.PartialAsync("~/Areas/admin/Views/Shared/_SeoFields.cshtml", Model.SEOMarkup);

                    <div class="form-group">
                        <div class="col-md-6 col-md-offset-3 col-sm-offset-4 col-sm-6 col-xs-12 ">

                            <input type="submit" class="btn btn-success p-x-5 ut-update" value="@Localizer["Update"]">
                            <input type="submit" class="btn btn-info p-x-5 ut-update_and_continue" value="@Localizer["save_and_continue"]" name="save-continue">
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



@section Styles{
    <link href="~/Admin/lib/bootstrap-tagsinput/dist/bootstrap-tagsinput.css" rel="stylesheet" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script src="~/Admin/js/validator.min.js"></script>

    <script src="~/Admin/lib/bootstrap-tagsinput/dist/bootstrap-tagsinput.js"></script>

    <script src="~/Admin/lib/tinymce/tinymce.js"></script>


    //seo scripts

    @{await Html.RenderPartialAsync("~/Areas/Admin/Views/Shared/_seoLabels.cshtml"); }
    <script src="~/Admin/js/serializejson.min.js"></script>
    <script src="~/Admin/js/seo.min.js"></script>
    <script>
        tinymce.init({
            selector: '#Content',
            branding: false,
            theme: 'modern',
            height: 300,
            plugins: ['advlist autolink link image lists charmap print preview hr anchor pagebreak spellchecker ',
                'searchreplace wordcount visualblocks visualchars code fullscreen insertdatetime media nonbreaking',
                'save table contextmenu directionality emoticons template paste textcolor'],
            toolbar: 'insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image | print preview media fullpage | forecolor backcolor emoticons',

            setup: function (editor) {
                editor.on('change', function (e) {
                    editor.save();
                });
            }
        });

        tinymce.init({
            selector: '#Summary',
            branding: false,
            min_height: 150,
            statusbar: false,
            theme: 'modern',
            menubar: false,
            plugins: ['code hr anchor pagebreak spellchecker '],
            setup: function (editor) {
                editor.on('change', function (e) {
                    editor.save();
                });
            }
        });



        $('#keywords').tagsinput({
            tagClass: 'tag'
        });
    </script>
}


