@model EditMenuVM

@{
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}

<div class="modal fade" id="MenuItemModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content ut-modal">
            <div class="content">
                <ul class="nav nav-tabs navs-line" role="tablist">
                    <li role="presentation" class="active" data-type="Page">
                        <a href="#@MenuItemTypeEnum.page.ToString()"
                           aria-controls="@MenuItemTypeEnum.page.ToString()"
                           role="tab"
                           data-toggle="tab"
                           class="ut-page-tab" ><strong>Page</strong></a>
                    </li>
                    @*<li role="presentation" data-type="product" >
                        <a href="#@MenuItemTypeEnum.product.ToString()"
                           aria-controls="@MenuItemTypeEnum.product.ToString()"
                           role="tab"
                           class="ut-product-tab"
                           data-toggle="tab"><strong>@Localizer["product"]</strong></a>
                    </li>*@
                    <li role="presentation" data-type="dropdown">
                        <a href="#@MenuItemTypeEnum.dropdown.ToString()"
                           aria-controls="@MenuItemTypeEnum.dropdown.ToString()"
                           role="tab"
                           class="ut-submenu-tab"
                           data-toggle="tab"><strong>@Localizer["parent_menu"]</strong></a>
                    </li>
                    <li role="presentation" data-type="Url">
                        <a href="#@MenuItemTypeEnum.url.ToString()"
                           aria-controls="@MenuItemTypeEnum.url.ToString()"
                           role="tab"
                           class="ut-link"
                           data-toggle="tab"><strong>@Localizer["link"]</strong></a>
                    </li>

                    <li role="presentation" data-type="Url">
                        <a href="#@MenuItemTypeEnum.staticpage.ToString()"
                           aria-controls="@MenuItemTypeEnum.staticpage.ToString()"
                           role="tab"
                           class="ut-staticpage-tab"
                           data-toggle="tab"><strong>@Localizer["static_page"]</strong></a>
                    </li>
                </ul>


                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane fade in active" id="@MenuItemTypeEnum.page.ToString()">



                        <form  asp-action="CreateMenuItemAsync" asp-controller="menus"
                              method="post"
                              class="form-horizontal forn-new form-label-left p-x-5 p-y-3 ut-page-form"
                              id="PageMenuItem">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger">
                                    @Html.ValidationSummary()
                                </div>
                            }

                            <input type="hidden" name="MenuId" value="@Model.Id" />
                            <input type="hidden" name="ItemType" value="@MenuItemTypeEnum.page.ToString()" />
                            <input type="hidden" name="parentKey" value="" />
                            <input type="hidden" name="Lang" value="@activeLang" />

                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> Title </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="text" name="Title" id="page-Title" class="form-control ut-title-input" required>
                                </div>
                            </div>


                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_name"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">

                                    <select style="width:100%"
                                            name="Url" id="page-Url"
                                            asp-items="ViewBag.PagesSelectList"
                                            class="form-control select_picker"
                                            required
                                            data-live-search="true"
                                            data-style="btn-select"></select>
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_display_order"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="number" name="DisplayOrder" id="PageDisplayOrder" step="1"  min="0" value="0" class="form-control ut-order-input">
                                </div>
                            </div>

                            <div class=" clearfix text-right">
                                <input type="submit" value="Add to menu" class="btn btn-success ut-page-send">
                                <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["close"]</button>
                            </div>

                        </form>



                    </div>
                    <div role="tabpanel" class="tab-pane fade" id="@MenuItemTypeEnum.product.ToString()">
                        <form asp-action="CreateMenuItemAsync" asp-controller="menus"
                              method="post"
                              class="form-horizontal forn-new form-label-left p-5 ut-product-form"
                              id="PageMenuItem">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger">
                                    @Html.ValidationSummary()
                                </div>
                            }
                            <input type="hidden" name="MenuId" value="@Model.Id" />
                            <input type="hidden" name="ItemType" value="@MenuItemTypeEnum.product.ToString()" />
                            <input type="hidden" name="parentKey" value="" />
                            <input type="hidden" name="Lang" value="@activeLang" />
                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_title"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="text" name="Title" id="product-Title" class="form-control ut-title-input" required>
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_name"]</label>
                                <div class="col-md-9 col-sm-8 col-xs-12">

                                    <select style="width:100%"
                                            name="Url" id="product-Url"
                                            asp-items="ViewBag.ProductsSelectList"
                                            class="form-control select_picker"
                                            required
                                            data-live-search="true"
                                            data-style="btn-select"></select>
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_display_order"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="number" name="DisplayOrder" id="ProductDisplayOrder" step="1" min="0" value="0" class="form-control ut-order-input">
                                </div>
                            </div>

                            <div class=" clearfix text-right">
                                <input type="submit" value="Add to menu" class="btn btn-success ut-product-send">
                                <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["close"]</button>
                            </div>

                        </form>
                    </div>
                    <div role="tabpanel" class="tab-pane fade " id="@MenuItemTypeEnum.dropdown.ToString()">
                        <form asp-action="CreateMenuItemAsync" asp-controller="menus"
                             method="post" 
                            class="form-horizontal forn-new form-label-left p-x-5 p-y-3 ut-submenu-form">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger">
                                    @Html.ValidationSummary()
                                </div>
                            }
                            <input type="hidden" name="MenuId" value="@Model.Id" />
                            <input type="hidden" name="ItemType" value="@MenuItemTypeEnum.dropdown.ToString()" />
                            <input type="hidden" name="parentKey" value="" />
                            <input type="hidden" name="Lang" value="@activeLang" />
                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_title"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="text" name="Title" id="url-Title" class="form-control ut-title-input" required>
                                    <input type="hidden" name="Url" value="#" />
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_display_order"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="number" name="DisplayOrder" id="dropdownDisplayOrder" step="1" min="0" value="0" class="form-control ut-order-input">
                                </div>
                            </div>
                            <div class=" clearfix text-right">
                                <input type="submit" value="Add to menu" class="btn btn-success ut-submenu-send">
                                <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["close"]</button>
                            </div>

                        </form>
                    </div>
                    <div role="tabpanel" class="tab-pane fade" id="@MenuItemTypeEnum.url.ToString()">

                        
                        <form asp-action="CreateMenuItemAsync" asp-controller="menus"
                                method="post" class="form-horizontal forn-new form-label-left p-x-5 p-y-3 ut-link-form">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger">
                                    @Html.ValidationSummary()
                                </div>
                            }
                            <input type="hidden" name="MenuId" value="@Model.Id" />
                            <input type="hidden" name="ItemType" value="@MenuItemTypeEnum.url.ToString()" />
                            <input type="hidden" name="parentKey" value="" />
                            <input type="hidden" name="Lang" value="@activeLang" />
                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_title"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="text" name="Title" id="url-Title" class="form-control ut-title-input" required>
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4">@Localizer["f_url"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="text" name="Url" id="Url" class="form-control" required>
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4">@Localizer["f_url_target"]</label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <select class="form-control" name="UrlTarget" id="UrlTarget">
                                        <option value="_blank" selected>_blank</option>
                                        <option value="_self">_self</option>
                                        <option value="_parent">_parent</option>
                                        <option value="_top">_top</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_display_order"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="number" name="DisplayOrder" id="UrlDisplayOrder" step="1" value="0" min="0" class="form-control ut-order-input">
                                </div>
                            </div>
                            <div class=" clearfix text-right">
                                <input type="submit" value="Add" class="btn btn-success ut-link-send">
                                <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["close"]</button>
                            </div>

                        </form>

                        </div>

                    <div role="tabpanel" class="tab-pane fade" id="@MenuItemTypeEnum.staticpage.ToString()">
                        <form asp-action="CreateMenuItemAsync" asp-controller="menus" method="post" 
                        class="form-horizontal forn-new form-label-left p-x-5 p-y-3 ut-staticpage-form">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger">
                                    @Html.ValidationSummary()
                                </div>
                            }
                            <input type="hidden" name="MenuId" value="@Model.Id" />
                            <input type="hidden" name="ItemType" value="@MenuItemTypeEnum.staticpage.ToString()" />
                            <input type="hidden" name="parentKey" value="" />
                            <input type="hidden" name="Lang" value="@activeLang" />
                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_title"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="text" name="Title" id="url-Title" class="form-control ut-title-input" required>
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_name"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">

                                    <select style="width:100%"
                                            name="Url" id="Static-page-Url"
                                            asp-items="ViewBag.StaticPagesSelectList"
                                            class="form-control select_picker ut-staticpage-url"
                                            required
                                            data-live-search="true"
                                            data-style="btn-select"></select>
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                <label class="control-label col-md-3 col-sm-4"> @Localizer["f_display_order"] </label>
                                <div class="col-md-9 col-sm-8 col-xs-12">
                                    <input type="number" name="DisplayOrder" id="StaticPageDisplayOrder" step="1" value="0" min="0" class="form-control ut-order-input">
                                </div>
                            </div>
                            <div class=" clearfix text-right">
                                <input type="submit" value="Add" class="btn btn-success ut-staticpage-send">
                                <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["close"]</button>
                            </div>

                        </form>
                    </div>
                    </div>
            </div>
        </div>
    </div>
</div>


