<div id="sidebar-menu" class="main_menu_side hidden-print main_menu">

    <div class="menu_section">

        <ul class="nav side-menu">

            @{
                string activeController = ViewContext.RouteData.Values["Controller"].ToString();
                string activeAction = ViewContext.RouteData.Values["Action"].ToString();
              
            }
            <li>
                <a asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="fa fa-home"></i>@Localizer["Home"]</a>
            </li>
             

            <li class='@((activeController == "Pages")  ?  "active" :""  )'>
                <a>
                    <i class="fa fa-files-o"></i> @Localizer["Pages"] <span class="fa fa-chevron-down"></span>
                </a>
                <ul class="nav child_menu">
                    <li class="@( activeController == " Pages" && activeAction=="Index" ? "current-page" :"" )">
                        <a href="@Url.AdminUrl("index","pages")">
                            <i class="fa fa-files-o"></i>
                            @Localizer["view_all"]
                        </a>
                    </li>
                    <li class="@( activeController == " Pages" && activeAction=="CreateHtmlPage" ? "current-page" :""
                        )">
                        <a href="@Url.AdminUrl("CreateHtmlPage", "pages")"><i class="fa fa-plus"></i>@Localizer["new_html_page"]</a>
                    </li>
                    <li class="@( activeController == " Pages" && activeAction=="CreateSectionsPage" ? "current-page"
                        :"" )">
                        <a href="@Url.AdminUrl("CreateSectionsPage", "pages")">
                            <i class="fa fa-list-ol"></i>
                            @Localizer["new_section_page"]
                        </a>
                    </li>
                </ul>
            </li>

            <li class='@((activeController == "Menus")  ?  "active" :""  )'>
                <a><i class="fa fa-bars"></i> @Localizer["Menus"] <span class="fa fa-chevron-down"></span></a>
                <ul class="nav child_menu">
                    <li class="@( activeController == " Menus" ? "current-page" :"" )">
                        <a href="@Url.AdminUrl("index","menus")">
                            <i class="fa fa-bars" aria-hidden="true"></i>
                            @Localizer["view_all"]
                        </a>
                    </li>
                </ul>
            </li>
             
            <li class='@((activeController == "Services")  ?  "active" :""  )'>
                <a>
                    <i class="fa fa-cubes"></i>
                    @Localizer["Services"] <span class="fa fa-chevron-down"></span>
                </a>

                <ul class="nav child_menu">
                    <li class="@( activeController == " Services" && activeAction=="Index" ? "current-page" :"" )">
                        <a href="@Url.AdminUrl("index","services")" >
                            <i class="fa fa-cube"></i>@Localizer["view_all"]
                        </a>
                    </li>
                    <li class="@( activeController == " Services" && activeAction=="Create" ? "current-page" :"" )">
                        <a href="@Url.AdminUrl("Create","services")">
                            <i class="fa fa-plus"></i>@Localizer["new_service"]
                             
                        </a>
                    </li>
                </ul>

            </li>

            <li class='@((activeController == "Sliders")  ?  "active" :""  )'>
                <a>
                    <i class="fa fa-picture-o"></i> @Localizer["Sliders"] <span class="fa fa-chevron-down"></span>
                </a>
                <ul class="nav child_menu">
                    <li class="@( activeController == " Sliders" && activeAction=="Index" ? "current-page" :"" )">
                        <a href="@Url.AdminUrl("index","Sliders")">
                            <i class="fa fa-file-image-o"></i>@Localizer["view_all"]

                        </a>
                    </li>
                    <li class="@( activeController == " Sliders" && activeAction=="Create" ? "current-page" :"" )">
                        <a href="@Url.AdminUrl("CreateSlider","sliders")"><i class="fa fa-plus"></i>@Localizer["new_slider"]</a>
                    </li>
                </ul>
            </li>

            <li class='@((activeController == "Users")  ?  "active" :""  )'>
                <a><i class="fa fa-users"></i> @Localizer["Users"] <span class="fa fa-chevron-down"></span></a>
                <ul class="nav child_menu">
                    <li class="@( activeController == " Users" && activeAction=="Index" ? "current-page" :"" )">
                        <a href="@Url.AdminUrl("index","users")"><i class="fa fa-user"></i>@Localizer["view_all"]</a>
                    </li>
                    <li class="@( activeController == " Users" && activeAction=="Create" ? "current-page" :"" )">
                        <a href="@Url.AdminUrl("Create","users")">
                            <i class="fa fa-plus"></i>@Localizer["new_user"]
                        </a>
                    </li>
                </ul>
            </li>
            
        </ul>
    </div>
</div>