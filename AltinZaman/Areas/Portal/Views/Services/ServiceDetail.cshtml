@model ServiceDto
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Title) ?  Localizer["Services"].ToString()  : Model.Title;
    Layout = "_Layout";
    ViewData["ImageURl"] = (Model.MainImage != null) ? Model.MainImage : @Url.Content("~/portal/images/bgs/services.jpg");

    ViewData["pageTitle"] = Model.Title;


}
@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml", @ViewData)
@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />
    <partial name="~/Areas/Portal/Views/Shared/partials/_SEO.cshtml" model="Model.SEOMarkup" />
}

<section class="content">
    <div class="container">
        <div class="page-date wow fadeInUp animated">
            @( Model.CreatedDate.ToString("dd") )
            <div class="text">@( Model.CreatedDate.ToString("MMMM") )</div>
        </div>
        <div class="row mt-5">

            
            @if (Model.IconVisibility)
            {
                <div class="col-md-3 col-xs-12 hidden-sm">
                    <div class="ser-icon">
                        <i class="fa @Model.Icon"></i>
                    </div>
                </div>
            }
            
            @{ 
                string clas = (Model.IconVisibility) ? "col-md-9 col-xs-12 col-sm-12" : "col-md-12 col-sm-12 col-xs-12";
            }
                <div class="@clas">
                    @if (Model.IconVisibility)
                    {
                    <div class="visible-sm">
                        <div class="ser-icon-sm">
                            <i class="fa @Model.Icon"></i>
                        </div>
                    </div>
                    } 
                    <div class="text">
                        @Html.Raw(Model.Content)
                    </div>
                </div>
        </div>
    </div>
</section>

<br />
