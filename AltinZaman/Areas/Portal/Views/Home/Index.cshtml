
@{
    ViewData["Title"] = "TamTech";
    Layout = "_Layout";
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;


}

@section SEO {
    <script type="application/ld+json">
        {
        "@@context": "http://schema.org",
        "@@type": "Organization",
        "url":  "@ViewBag.Host",
        "logo": "@ViewBag.Host/portal/images/seoLogo.jpg"
        }
    </script>
}

@await Html.PartialAsync("~/Areas/Portal/Views/Home/partials/Index/_slider.cshtml")


@await Html.PartialAsync("~/Areas/Portal/Views/Home/partials/Index/_about.cshtml")
@await Html.PartialAsync("~/Areas/Portal/Views/Home/partials/Index/_services.cshtml")

@await Html.PartialAsync("~/Areas/Portal/Views/Home/partials/Index/_counters.cshtml")

@await Html.PartialAsync("~/Areas/Portal/Views/Home/partials/Index/_callUs.cshtml")

@await Html.PartialAsync("~/Areas/Portal/Views/Home/partials/Index/_clients.cshtml")

@section footer {



    <script src="~/portal/js/owl.carousel.min.js"></script>
    <script src="~/portal/js/slider-active.js" type="text/javascript"></script>
    <script src="~/portal/revolution/js/jquery.themepunch.tools.min.js" type="text/javascript">
    </script>
    <script src="~/portal/revolution/js/jquery.themepunch.revolution.min.js" type="text/javascript">
    </script>
    <script src="~/portal/revolution/js/extensions/revolution.extension.navigation.min.js" type="text/javascript">
    </script>
    <script src="~/portal/revolution/js/extensions/revolution.extension.parallax.min.js" type="text/javascript">
    </script>
    <script src="~/portal/revolution/js/extensions/revolution.extension.slideanims.min.js" type="text/javascript">
    </script>
    <script src="~/portal/js/validation.js"></script>
}



 

