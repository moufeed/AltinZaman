 
@{ 
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
<section class="contact-section contact-page">
    <div class="container">
        <div class="title m-b-5"><h3>@Localizer["send_us_meesage"]</h3></div>

        <form action="/@lang/Portal/Home/contactus" method="post" id="contact-form" data-id="contact-form" class="default-form">


            <div class="row">
                <div class="col-md-6 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <input type="text" placeholder="@Localizer["name"].." name="Name" required />
                    </div>
                    <div class="form-group">
                        <input type="tel" placeholder="@Localizer["Phone"].." name="Mobile" id="cphone" />
                    </div>
                    <div class="form-group">
                        <input type="email" placeholder="@Localizer["Email"].." name="Email" id="cemail">
                    </div>
                </div>
                <div class="col-md-6 col-sm-6 col-xs-12">
                    <div class="clerfix">
                        <textarea cols="30" rows="4" placeholder="@Localizer["Message"].." name="Message" required></textarea>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn-one style-one radi" 
                                data-loading-text="@Localizer["please_wait"] ..."
                                data-success-text="@Localizer["We_have_received_your_message"]" > @Localizer["Send_it"]</button>
                    </div>
                </div>

            </div>
        </form>
    </div>
</section>
 