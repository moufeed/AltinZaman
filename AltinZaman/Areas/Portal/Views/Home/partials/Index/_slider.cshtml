
@using TamTechSDK.Common.Services.ContentService.Sliders.Models;
@{
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
@if (ViewBag.publicMainSlider != null)
{
    SliderDto mainSlider = (SliderDto)ViewBag.publicMainSlider;
    @if (mainSlider.Items != null && mainSlider.Items.Count > 0)
    {
        <section class="main-slider">

            <article class="content">
                <div class="rev_slider_wrapper fullwidthbanner-container" data-source="gallery" id="rev_slider_486_1_wrapper" style="margin:0px auto;background-color:#ffffff;padding:0px;margin-top:0px;margin-bottom:0px;">
                    <!-- START REVOLUTION SLIDER 5.4.1 fullwidth mode -->


                    <div class="rev_slider fullwidthabanner" data-version="5.4.1" id="rev_slider_486_1" style="display:none;">
                        <ul>
                            @foreach (var item in mainSlider.Items)
                            {
                                <li data-description="Science says that Women are generally happier"
                                    data-easein="default"
                                    data-easeout="default"
                                    data-fsmasterspeed="1500"
                                    data-fsslotamount="7"
                                    data-fstransition="fade"
                                    data-hideafterloop="0"
                                    data-hideslideonmobile="off"
                                    data-index="rs-1687"
                                    data-masterspeed="default"
                                    data-rotate="0"
                                    data-saveperformance="off"
                                    data-slotamount="default"
                                    data-thumb="@item.MainImage"
                                    data-transition="parallaxvertical">


                                    <img alt="" class="rev-slidebg"
                                         data-bgfit="cover"
                                         data-bgparallax="10"
                                         data-bgposition="center center"
                                         data-bgrepeat="no-repeat"
                                         data-no-retina=""
                                         src="@item.MainImage">

                                </li>
                            }
                        </ul>

                        <div class="tp-bannertimer tp-bottom" style="height: 5px; background-color: #ffd800;">
                        </div>
                    </div>
                </div>

            </article>


        </section>
    }
}

 