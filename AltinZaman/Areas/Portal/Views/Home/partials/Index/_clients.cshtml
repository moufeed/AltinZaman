<!-- sponsors section -->
<section class="sponsors-section">
    <div class="container">
        <div class="sponsors-area">
            <ul class="sponsors-slider" data-rtl="true">

                @if (ViewBag.publicClientsSlider != null)
                {
                    @foreach (var item in ViewBag.publicClientsSlider.Items)
                    {
                        <li><a href="#"><figure><img src="@item.MainImage" alt=""></figure></a></li>
                    }
                }

            </ul>
        </div>
    </div>
</section>
<!-- sponsors section end -->