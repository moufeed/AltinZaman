
@{
    ViewData["Title"] = @Localizer["حول الشركة"];
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/Portal/Images/bgs/about.jpg");
    ViewData["pageTitle"] = Localizer["About_Us"];
}

@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml", @ViewData)



@section SEO{

<script type="application/ld+json">
    {
    "@@context":"http://schema.org",
    "@@type":"LocalBusiness",
    "image":"@ViewBag.Host/Portal/img/seoLogo.jpg",
    "name":"@Localizer["site_title"]",
    "@@type":"PostalAddress",
    "streetAddress":"E5 yan yol Civan Cokak",
    "addressLocality":"Avcılar Üniversite Mh",
    "addressRegion":"İstanbul",
    "postalCode":"34320",
    "addressCountry":"Turkey"
    },
    "geo":{
    "@@type":"GeoCoordinates",
    "latitude":40.991939 ,
    "longitude":28.713351
    },
    "telephone":""
    }
</script>
}


<section class="about_us_section">
    @await Html.PartialAsync("~/Areas/Portal/Views/Home/partials/aboutus/_description.cshtml")


    @await Html.PartialAsync("~/Areas/Portal/Views/Home/partials/aboutus/_statistics.cshtml")

    <section class="feature-section sec-pad">
        <div class="container">
            <div class="feature-title centered">
                <div class="section-title"><h2>لماذا الزمان الذهبي؟</h2></div>
                <div class="title-text"><p>شركة خدمية تجارية تتمتع بشخصية اعتبارية ذات استقلال مالي وإداري تام في ممارسة أنشطتها ومهامها</p></div>
            </div>
            <div class="row">
                <div class="col-md-4 col-sm-6 col-xs-12 feature-colmun">
                    <div class="single-item">
                        <div class="img-box"><figure><img src="~/Portal/images/feature/1.jpg" alt=""></figure></div>
                        <div class="single-content">
                            <div class="icon-box"><i class="flaticon-graphic"></i></div>
                            <h4>المصداقية</h4>
                            <div class="text"><p>نظراً لتفشّي حالات الاحتيال المتزايدة ضمن هذا الاختصاص في سوق العمل فقد أقرّت الشركة وضع كامل ثقلها وطاقتها الإنتاجية لتقديم أصدق وأسمى أنواع الخدمات .</p></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6 col-xs-12 feature-colmun">
                    <div class="single-item">
                        <div class="img-box"><figure><img src="~/Portal/images/feature/2.jpg" alt=""></figure></div>
                        <div class="single-content">
                            <div class="icon-box"><i class="fa fa-clock-o"></i></div>
                            <h4>سرعة في الإنجاز</h4>
                            <div class="text"><p>حيث تعتبر من أهم الميزات التي تتمتع بها الشركة هي السرعة في تقديم وانجاز الخدمات </p></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6 col-xs-12 feature-colmun">
                    <div class="single-item">
                        <div class="img-box"><figure><img src="~/Portal/images/feature/3.jpg" alt=""></figure></div>
                        <div class="single-content">
                            <div class="icon-box"><i class="flaticon-money"></i></div>
                            <h4>أسعار مناسبة</h4>
                            <div class="text"><p>تعتمد إدارة الشركة نظام مالي موحد يستند على سياسة مالية مدروسة بدقة يتم بناءً عليها تحديد الأسعار والتكاليف </p></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</section>
