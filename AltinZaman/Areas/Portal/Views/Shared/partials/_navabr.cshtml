
@{
    string activeController = ViewContext.RouteData.Values["Controller"].ToString();
    string activeAction = ViewContext.RouteData.Values["Action"].ToString();



}

@using System.Text;

@functions {


public string PrintMenu(List<MenuItemDto> MenuItems)

{
    StringBuilder stringBuilder = new StringBuilder("<ul class=\"list-unstyled submenu\">");




    if (MenuItems?.Count > 0)
    {
        foreach (var item in MenuItems)
        {
            PrintMenuItem(item, stringBuilder);
        }
    }


    stringBuilder.Append("</ul>");


    return stringBuilder.ToString();

}


private void PrintMenuItem(MenuItemDto dto, StringBuilder stringBuilder)
{



    if (dto.ItemType.Equals(MenuItemTypeEnum.product.ToString(), StringComparison.OrdinalIgnoreCase))
    {
        stringBuilder.Append("<li class=\"\">");
        stringBuilder.Append($"<a href=\"{(string)@ViewBag.paths[MenuItemTypeEnum.product.ToString()]}/{dto.Url}\" class=\"dropdown-item\">{dto.Title}</a>");
        stringBuilder.Append("</li>");
    }

    if (dto.ItemType.Equals(MenuItemTypeEnum.page.ToString(), StringComparison.OrdinalIgnoreCase))
    {
        stringBuilder.Append("<li class=\"\">");
        stringBuilder.Append($"<a href=\"{(string)@ViewBag.paths[MenuItemTypeEnum.page.ToString()]}/{dto.Url}\" class=\"dropdown-item\">{dto.Title}</a>");
        stringBuilder.Append("</li>");
    }

    if (dto.ItemType.Equals(MenuItemTypeEnum.url.ToString(), StringComparison.OrdinalIgnoreCase))
    {
        stringBuilder.Append("<li class=\"\">");
        var target = (dto.UrlTarget?.Length > 0) ? dto.UrlTarget : "_blank";

        stringBuilder.Append($"<a href=\"{dto.Url}\" class=\"dropdown-item\" target=\"{target}\">{dto.Title}</a>");
        stringBuilder.Append("</li>");
    }

    if (dto.ItemType.Equals(MenuItemTypeEnum.dropdown.ToString(), StringComparison.OrdinalIgnoreCase) && dto.MenuItems?.Count > 0)
    {
        stringBuilder.Append("<li class=\"dropdown-submenu item-has-submenu\">");
        var sublavel = PrintMenu(dto.MenuItems);
        stringBuilder.Append($"<a class=\"dropdown-item  \" href=\"#\">{dto.Title} <i class=\"fa fa-caret\"></i></a>");

        stringBuilder.Append(sublavel);

        stringBuilder.Append("</li>");
    }

}


}
 



<nav class="navbar navbar-expand-md navbar-light main-navbar">
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav mr-auto">

           

            @if (ViewBag.Menu != null && ViewBag.Menu.MenuItems != null)
            {
 
                @foreach (var item in ViewBag.Menu.MenuItems)
                {

                    @if (item.ItemType.Equals(MenuItemTypeEnum.product.ToString(), StringComparison.OrdinalIgnoreCase))
                    {

            <li class="nav-item">
                         <a asp-controller="products" asp-action="@item.Url" asp-route-id="@item.Url" class="nav-link">@item.Title</a>
                @*<a class="nav-link" href="@((string)@ViewBag.paths[MenuItemTypeEnum.product.ToString()])/@item.Url">@item.Title</a>*@
            </li>
                    }
                    else if (item.ItemType.Equals(MenuItemTypeEnum.page.ToString(), StringComparison.OrdinalIgnoreCase))
                    {
            <li class="nav-item">
                <a asp-controller="pages" asp-action="@item.Url" asp-route-slug="@item.Url" class="nav-link">@item.Title</a>
                @*<a class="nav-link" href="@((string)@ViewBag.paths[MenuItemTypeEnum.page.ToString()])/@item.Url">@item.Title</a>*@
            </li>

                    }

                    else if (item.ItemType.Equals(MenuItemTypeEnum.staticpage.ToString(), StringComparison.OrdinalIgnoreCase))
                    {  
                        <li class="nav-item">
                           <a class="nav-link" href='/@System.Globalization.CultureInfo.CurrentCulture.Name/Portal/@item.Url'>@item.Title</a>
                        </li> 
                    }

                    else if (item.ItemType.Equals(MenuItemTypeEnum.url.ToString(), StringComparison.OrdinalIgnoreCase))
                    {
                        <li class="nav-item"> 
                            <a class="nav-link" href="@item.Url" target="@item.UrlTarget">@item.Title</a>
                        </li>
                    }
                    else if (item.ItemType.Equals(MenuItemTypeEnum.dropdown.ToString(), StringComparison.OrdinalIgnoreCase) && item.MenuItems?.Count > 0)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button">
                                @item.Title
                            </a>

                            <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                                @Html.Raw(PrintMenu(item.MenuItems))
                            </div>



                        </li>
                    }




                }


            }


        </ul>
    </div>
</nav>


